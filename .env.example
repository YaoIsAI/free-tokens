# 复制为 .env 并按需修改（生产值必须用 openssl rand -hex 32 生成）
PORT=3000
DB_PATH=data/app.db
# 生产必须设置 NODE_ENV=production（激活 JWT 密钥强度/缺失等 fail-fast 守卫）与强随机 JWT_SECRET
NODE_ENV=production
# 生产必须设置强随机 JWT_SECRET；不设置则非生产环境用临时随机密钥（重启失效）
JWT_SECRET=
# 站点主域（SEO 收敛，默认 https://free-tokens.org，本地可覆为 http://localhost:3000）
PRIMARY_ORIGIN=https://free-tokens.org
# AI 判官专用（可选，留空则走池子自动选；填则优先专用，不回退）
AI_JUDGE_BASE_URL=
AI_JUDGE_TOKEN=
AI_JUDGE_MODEL=
# 定时巡检间隔（小时）：自动检测失效 Token 并下线；默认 6，最小 1；0 = 关闭自动巡检（仅手动 cli admin check）
SWEEP_INTERVAL_HOURS=6
